{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "reeltunes-codes",
  "main": "src/index.js",
  "compatibility_date": "2026-11-04",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reeltunes-codes",
      "database_id": "52fe2891-0753-4787-95df-8a3d11c04ad7"
    }
  ]
}
